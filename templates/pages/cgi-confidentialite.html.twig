<!-- CONTENU -->
<section class="page-body" aria-label="Mentions légales et politique de confidentialité">
  <div class="container">

    <p style="font-size:13px;color:var(--gray-500);margin-bottom:32px;">Dernière mise à jour : Juin 2026 · Document applicable à tout utilisateur du site cgi-mfi.com</p>

    <!-- MENTIONS LÉGALES -->
