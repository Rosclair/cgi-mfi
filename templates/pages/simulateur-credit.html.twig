{% extends 'base.html.twig' %}

{% block title %}Simulateur de Crédit MICRO-CRÉDIT 2% | CGI MFI Cameroun{% endblock %}
{% block meta_description %}Simulez votre crédit CGI MFI : calculez vos mensualités, le coût total et le tableau d'amortissement. MICRO-CRÉDIT 2%/mois dégressif. Zéro surprise.{% endblock %}
{% block og_title %}Simulateur de Crédit — MICRO-CRÉDIT 2% | CGI MFI{% endblock %}
{% block og_description %}Calculez exactement ce que vous paierez avant de vous engager. Simulateur MICRO-CRÉDIT 2% avec tableau d'amortissement complet. CGI MFI Yaoundé.{% endblock %}
{% block og_url %}https://www.cgi-mfi.com/simulateur-credit{% endblock %}
{% block canonical %}https://www.cgi-mfi.com/simulateur-credit{% endblock %}

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cgi-mfi.com/"},
    {"@type": "ListItem", "position": 2, "name": "Simulateur de Crédit", "item": "https://www.cgi-mfi.com/simulateur-credit"}
  ]
}
</script>
{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/simulateur-credit.css') }}">
{% endblock %}

{% block body %}

<!-- HERO SIMULATEUR -->
<section class="sim-hero" aria-label="Simulateur de crédit CGI">
  <div class="sim-hero-inner">
    <div class="sim-hero-badge">Outil de Transparence - MICRO-CRÉDIT 2%</div>
    <h1 class="sim-hero-title">
      Simulez votre crédit<br>avant de vous <span>engager</span>
    </h1>
    <p class="sim-hero-sub">
      CGI vous montre exactement ce que vous allez payer avant signature.
      MICRO-CRÉDIT 2%/mois sur capital restant dû - Zéro surprise au guichet.
    </p>
    <div class="sim-hero-trust">Ce que vous voyez = ce que vous paierez</div>
  </div>
</section>

<!-- SIMULATEUR CENTRAL -->
<section class="simulateur" id="simulateur" aria-label="Configurateur de crédit">
  <div class="container">
    <div class="sim-layout">

      <!-- FORMULAIRE -->
      <div class="sim-form-card">
        <div class="sim-form-header">
          <div class="sim-form-header-title">Configurer votre crédit</div>
          <div class="sim-form-header-tag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            Calcul instantané
          </div>
        </div>
        <div class="sim-form-body">
          <div class="sim-field">
            <div class="sim-label">Produit CGI</div>
            <div class="sim-produit-tag">
              <span class="sim-produit-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></span>
              <div><div class="sim-produit-name">MICRO-CRÉDIT 2%</div><div class="sim-produit-rate">Taux dégressif 2% / mois sur capital restant dû</div></div>
            </div>
          </div>
          <div class="sim-field">
            <label class="sim-label" for="montantInput">
              <span>Montant du crédit</span>
              <span class="sim-label-value" id="montantDisplay" aria-live="polite">300 000 FCFA</span>
            </label>
            <div class="sim-montant-wrap">
              <span class="sim-currency" aria-hidden="true">FCFA</span>
              <input type="number" class="sim-input-num" id="montantInput" min="50000" max="2000000" step="10000" value="300000" aria-label="Montant du crédit en FCFA" oninput="syncFromInput()">
            </div>
            <input type="range" class="sim-range" id="montantRange" min="50000" max="2000000" step="10000" value="300000" aria-label="Curseur montant du crédit" oninput="syncFromRange()">
            <div class="sim-range-labels" aria-hidden="true"><span>50 000</span><span>500 000</span><span>1 000 000</span><span>2 000 000</span></div>
          </div>
          <div class="sim-field">
            <div class="sim-label"><span>Durée de remboursement</span><span class="sim-label-value" id="dureeDisplay" aria-live="polite">12 mois</span></div>
            <div class="sim-dur-btns" role="group" aria-label="Durée de remboursement">
              <button class="sim-dur-btn" onclick="setDuree(3)"  data-dur="3"  aria-pressed="false">3 mois</button>
              <button class="sim-dur-btn" onclick="setDuree(6)"  data-dur="6"  aria-pressed="false">6 mois</button>
              <button class="sim-dur-btn active" onclick="setDuree(12)" data-dur="12" aria-pressed="true">12 mois</button>
              <button class="sim-dur-btn" onclick="setDuree(18)" data-dur="18" aria-pressed="false">18 mois</button>
            </div>
          </div>
          <div class="sim-field">
            <div class="sim-label">Frais optionnels</div>
            <div class="sim-optionals">
              <div class="sim-opt-field"><label for="fraisDossier">Frais de dossier</label><div class="sim-opt-wrap"><input type="number" id="fraisDossier" min="0" max="10" step="0.1" value="1" aria-label="Frais de dossier en pourcentage" oninput="recalculate()"><span class="sim-opt-unit" aria-hidden="true">%</span></div></div>
              <div class="sim-opt-field"><label for="assurance">Assurance</label><div class="sim-opt-wrap"><input type="number" id="assurance" min="0" max="5" step="0.1" value="0" aria-label="Prime d'assurance en pourcentage" oninput="recalculate()"><span class="sim-opt-unit" aria-hidden="true">%</span></div></div>
            </div>
          </div>
        </div>
      </div>

      <!-- RÉSULTATS -->
      <div class="sim-results-card" role="region" aria-label="Résultats de la simulation" aria-live="polite">
        <div class="sim-results-header">
          <div class="sim-results-title"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>Résultats en temps réel</div>
          <div class="sim-update-dot">Mis à jour</div>
        </div>
        <div class="sim-results-body">
          <div class="sim-monthly-hero">
            <div class="sim-monthly-label">Mensualité estimée</div>
            <div class="sim-monthly-val" id="mensualiteVal">-</div>
            <div class="sim-monthly-unit">FCFA / mois</div>
          </div>
          <div class="sim-res-grid">
            <div class="sim-res-item"><div class="sim-res-label">Total à rembourser</div><div class="sim-res-val highlight" id="totalRembVal">-</div></div>
            <div class="sim-res-item"><div class="sim-res-label">Total intérêts</div><div class="sim-res-val" id="totalInteretVal">-</div></div>
            <div class="sim-res-item"><div class="sim-res-label">Capital emprunté</div><div class="sim-res-val" id="capitalVal">-</div></div>
            <div class="sim-res-item"><div class="sim-res-label">Durée</div><div class="sim-res-val" id="dureeVal">-</div></div>
            <div class="sim-res-item"><div class="sim-res-label">Frais de dossier</div><div class="sim-res-val" id="fraisDossierVal">-</div></div>
            <div class="sim-res-item"><div class="sim-res-label">Taux nominal annuel</div><div class="sim-res-val" id="tauxNominalVal">-</div></div>
          </div>
          <div class="sim-breakdown">
            <div class="sim-breakdown-title">Répartition du coût total</div>
            <div class="sim-breakdown-bar" role="presentation">
              <div class="sim-bar-capital"  id="barCapital"  style="width:70%"></div>
              <div class="sim-bar-interest" id="barInterest" style="width:25%"></div>
              <div class="sim-bar-fees"     id="barFees"     style="width:5%"></div>
            </div>
            <div class="sim-breakdown-legend" aria-label="Légende répartition">
              <div class="sim-legend-item"><div class="sim-legend-dot" style="background:var(--dark)"  aria-hidden="true"></div>Capital</div>
              <div class="sim-legend-item"><div class="sim-legend-dot" style="background:var(--red)"   aria-hidden="true"></div>Intérêts</div>
              <div class="sim-legend-item"><div class="sim-legend-dot" style="background:var(--gold)"  aria-hidden="true"></div>Frais</div>
            </div>
          </div>
          <div class="sim-cta-block">
            <a href="{{ path('home') }}#join" class="sim-cta-main">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>
              Demander ce crédit
            </a>
            <p class="sim-cta-note">Réponse garantie en 48h · Conditions définitives après étude de dossier</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- TABLEAU D'AMORTISSEMENT -->
<section class="amortissement" id="tableau" aria-label="Tableau d'amortissement mensuel">
  <div class="container">
    <div class="amort-header">
      <div>
        <div class="section-eyebrow">Transparence totale</div>
        <h2 class="section-title" style="margin-bottom:8px;">Tableau d'Amortissement</h2>
        <p style="font-size:14px;color:var(--gray-500);">Chaque centime expliqué - mois par mois</p>
      </div>
      <div class="amort-info-badge">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
        <div><div class="amort-info-badge-title">Intérêts dégressifs</div><div class="amort-info-badge-sub">Vous payez moins au fil du temps</div></div>
      </div>
    </div>
    <div class="amort-scroll">
      <table id="amortTable" aria-label="Tableau d'amortissement du crédit">
        <thead>
          <tr><th scope="col">Mois</th><th scope="col">Capital restant dû</th><th scope="col">Intérêts</th><th scope="col">Capital remboursé</th><th scope="col">Mensualité</th></tr>
        </thead>
        <tbody id="amortBody"></tbody>
        <tfoot>
          <tr id="amortTotals"><td><strong>TOTAL</strong></td><td>-</td><td class="interest-col" id="totalInteretFoot">-</td><td id="totalCapitalFoot">-</td><td id="totalMensualiteFoot">-</td></tr>
        </tfoot>
      </table>
    </div>
  </div>
</section>

<!-- SECTION TRANSPARENCE -->
<section class="transparence" id="transparence" aria-label="Engagement de transparence CGI">
  <div class="container">
    <div style="text-align:center;">
      <div class="section-eyebrow" style="color:var(--gold);">Notre engagement</div>
      <h2 class="section-title" style="color:var(--white);margin-bottom:12px;">Zéro Surprise - Notre Promesse</h2>
      <p style="font-size:16px;color:rgba(255,255,255,0.6);max-width:600px;margin:0 auto;line-height:1.7;">Chez CGI, transparence n'est pas un slogan. C'est un engagement contractuel.</p>
    </div>
    <div class="trans-grid">
      <div class="trans-card"><div class="trans-icon" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"/><polyline points="16 17 22 17 22 11"/></svg></div><h3 class="trans-title">Taux Dégressif Expliqué</h3><p class="trans-desc">Contrairement à un taux fixe, votre intérêt est calculé chaque mois sur le capital qu'il vous reste réellement à rembourser. Plus vous remboursez, moins vous payez d'intérêts.</p><span class="trans-highlight">✓ Formule : Intérêt du mois = Capital restant × 2%</span></div>
      <div class="trans-card"><div class="trans-icon" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg></div><h3 class="trans-title">Remboursement Anticipé</h3><p class="trans-desc">Vous pouvez rembourser votre crédit en avance, partiellement ou en totalité, à tout moment. Vous économisez automatiquement les intérêts restants. Aucune pénalité.</p><span class="trans-highlight">✓ Pénalité anticipation : 0 FCFA</span></div>
      <div class="trans-card"><div class="trans-icon" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg></div><h3 class="trans-title">Différence avec le Taux Fixe</h3><p class="trans-desc">Un taux fixe applique le même taux sur le montant initial pendant toute la durée. Le taux dégressif CGI est toujours plus avantageux pour l'emprunteur.</p><span class="trans-highlight">✓ Économie estimée vs taux fixe : jusqu'à 15%</span></div>
      <div class="trans-card"><div class="trans-icon" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg></div><h3 class="trans-title">Ce qui est Affiché = Ce que vous Paierez</h3><p class="trans-desc">Le simulateur utilise exactement les mêmes formules que nos contrats officiels. Ce tableau d'amortissement est le même document que vous signerez.</p><span class="trans-highlight">✓ Engagement contractuel CGI</span></div>
    </div>
  </div>
</section>

<!-- SECTION CONVERSION -->
<section class="conversion" id="demande" aria-label="Demande de crédit CGI">
  <div class="conversion-inner">
    <div class="conversion-trust">Ce que vous voyez = ce que vous paierez</div>
    <h2 class="conversion-title">Prêt à concrétiser<br>votre projet ?</h2>
    <p class="conversion-sub">Votre simulation est prête. Faites la demande officielle maintenant - réponse en 48h garantie.</p>
    <div class="conversion-btns">
      <a href="{{ path('home') }}#join" class="btn-white">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>
        Demander ce crédit
      </a>
      <a href="{{ path('home') }}#join" class="btn-outline-white">Devenir membre CGI</a>
    </div>
  </div>
</section>

{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/simulateur-credit.js') }}" defer></script>
{% endblock %}
