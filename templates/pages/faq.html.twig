{% extends 'base.html.twig' %}

{% block title %}FAQ Microfinance — Crédit & Épargne | CGI MFI Cameroun{% endblock %}
{% block meta_description %}FAQ CGI MFI — Toutes les réponses sur le micro-crédit 2%, l'épargne CGI BUILD, l'adhésion et les services de microfinance. Yaoundé, Cameroun. Lancement JANVIER 2027.{% endblock %}
{% block og_title %}FAQ Microfinance | CGI MFI — Yaoundé, Cameroun{% endblock %}
{% block og_description %}Questions fréquentes sur CGI MFI : adhésion, MICRO-CRÉDIT 2%, épargne CGI BUILD, CGI DJANGUI+, Mobile Money. Microfinance inclusive au Cameroun.{% endblock %}
{% block og_url %}https://www.cgi-mfi.com/faq{% endblock %}
{% block canonical %}https://www.cgi-mfi.com/faq{% endblock %}

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {"@type": "Question", "name": "Qu'est-ce que CGI ?", "acceptedAnswer": {"@type": "Answer", "text": "Community Growth Initiative (CGI) est une coopérative d'épargne et de crédit de 1ère catégorie, en cours d'agrément COBAC, dont le siège est à Yaoundé, Cameroun. Lancement prévu en JANVIER 2027."}},
    {"@type": "Question", "name": "Comment devenir membre CGI ?", "acceptedAnswer": {"@type": "Answer", "text": "Remplissez le formulaire d'inscription, fournissez vos documents KYC, payez l'adhésion à partir de 4 900 FCFA."}},
    {"@type": "Question", "name": "Comment fonctionne le MICRO-CRÉDIT 2% ?", "acceptedAnswer": {"@type": "Answer", "text": "MICRO-CRÉDIT 2% est notre produit de crédit entrepreneurial avec réponse garantie en 48h. Taux 2%/mois dégressif sur capital restant dû. Dès 50 000 FCFA."}},
    {"@type": "Question", "name": "Quel taux d'intérêt sur l'épargne bloquée ?", "acceptedAnswer": {"@type": "Answer", "text": "CGI BUILD offre jusqu'à 8%/an, garanti à la signature du contrat."}}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cgi-mfi.com/"},
    {"@type": "ListItem", "position": 2, "name": "FAQ", "item": "https://www.cgi-mfi.com/faq"}
  ]
}
</script>
{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/faq.css') }}">
{% endblock %}

{% block body %}

<!-- HERO -->
<div class="page-hero">
  <div class="container">
    <nav class="page-breadcrumb" aria-label="Fil d'Ariane">
      <a href="{{ path('home') }}">Accueil</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">FAQ</span>
    </nav>
    <div class="page-eyebrow">Assistance &amp; Informations</div>
    <h1 class="page-title">Questions<br>Fréquentes</h1>
    <p class="page-subtitle">Toutes les réponses à vos questions sur CGI, nos produits, tarifs et processus - claires, complètes, honnêtes.</p>
    <div class="faq-hero-meta">
      <div class="faq-hero-meta-item"><span class="faq-hero-meta-dot" aria-hidden="true"></span>5 catégories</div>
      <div class="faq-hero-meta-item"><span class="faq-hero-meta-dot" aria-hidden="true"></span>16 questions</div>
      <div class="faq-hero-meta-item"><span class="faq-hero-meta-dot" aria-hidden="true"></span>Mise à jour : Janvier 2027</div>
    </div>
  </div>
</div>

<!-- CONTENU FAQ -->
<section class="page-body faq-body" aria-label="Questions fréquentes">
  <div class="container">
    <div class="faq-layout">

      <aside class="faq-nav" aria-label="Navigation rapide par catégorie">
        <div class="faq-nav-title">Catégories</div>
        <a href="#faq-fr-institution">Institution &amp; Adhésion</a>
        <a href="#faq-fr-credit">Crédit CGI</a>
        <a href="#faq-fr-epargne">Épargne</a>
        <a href="#faq-fr-digital">Mobile Money &amp; Digital</a>
        <a href="#faq-fr-formation">Formation &amp; Accompagnement</a>
      </aside>

      <div class="faq-main">

        <section id="faq-fr-institution" aria-labelledby="faq-fr-inst-title">
          <h2 class="faq-cat-title" id="faq-fr-inst-title">CGI - Institution &amp; Adhésion</h2>
          <div class="faq-item"><button class="faq-q" onclick="toggleFaq(this)" aria-expanded="false">Qu'est-ce que CGI ?<span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-a" role="region">Community Growth Initiative (CGI) est une coopérative d'épargne et de crédit (COOPEC) de 1ère catégorie avec Conseil d'Administration, en cours d'agrément COBAC, dont le siège social est à Yaoundé, Cameroun. CGI offre des services de microfinance inclusifs - épargne, crédit, Mobile Money et accompagnement entrepreneurial - à des conditions transparentes et accessibles, depuis son lancement prévu en <strong>Janvier 2027</strong>.</div></div>
          <div class="faq-item"><button class="faq-q" onclick="toggleFaq(this)" aria-expanded="false">Comment devenir membre CGI ?<span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-a" role="region"><p><strong>4 étapes simples :</strong></p><ol class="faq-ol"><li>Remplissez le formulaire d'inscription en ligne ou au siège CGI.</li><li>Fournissez vos documents KYC : CNI, justificatif de domicile, déclaration d'activité.</li><li>Payez votre adhésion à partir de <strong>4 900 FCFA</strong>.</li><li>Accédez immédiatement à tous les produits CGI.</li></ol><div class="highlight-box"><p>Les 100 premiers membres fondateurs bénéficient de conditions préférentielles et de droits exclusifs.</p></div></div></div>
          <div class="faq-item"><button class="faq-q" onclick="toggleFaq(this)" aria-expanded="false">Combien coûte l'adhésion ?<span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-a" role="region"><strong>À partir de 4 900 FCFA</strong> - ce montant inclut la part sociale, le droit d'entrée et la session d'orientation personnalisée de 30 minutes. C'est la microfinance la plus accessible du marché camerounais.</div></div>
          <div class="faq-item"><button class="faq-q" onclick="toggleFaq(this)" aria-expanded="false">CGI est-elle agréée et sûre ?<span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-a" role="region">CGI est en cours d'agrément <strong>COBAC</strong> (Commission Bancaire de l'Afrique Centrale) - l'autorité de supervision des établissements de microfinance en zone CEMAC. Notre modèle est conforme OHADA et CEMAC. Tous nos produits respectent les plafonds réglementaires de taux d'intérêt.</div></div>
          <div class="faq-item"><button class="faq-q" onclick="toggleFaq(this)" aria-expanded="false">Quand CGI ouvre-t-elle officiellement ?<span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-a" role="region">CGI prévoit son lancement officiel en <strong>Janvier 2027</strong>. Les inscriptions de membres fondateurs sont ouvertes dès maintenant. Rejoignez les premiers membres pour bénéficier de conditions préférentielles.</div></div>
        </section>

        <section id="faq-fr-credit" aria-labelledby="faq-fr-credit-title">
          <h2 class="faq-cat-title" id="faq-fr-credit-title">Crédit CGI</h2>
          <div class="faq-item"><button class="faq-q" onclick="toggleFaq(this)" aria-expanded="false">Comment fonctionne le MICRO-CRÉDIT ?<span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-a" role="region"><strong>MICRO-CRÉDIT</strong> est notre produit de crédit entrepreneurial de <strong>50 000 à 300 000 FCFA</strong> avec réponse garantie en <strong>48h ouvrables</strong>. Taux : <strong>2,5 %/mois dégressif</strong> (calculé sur le capital restant dû, pas sur le montant initial). Décaissement via Mobile Money (MTN ou Orange Money).</div></div>
          <div class="faq-item"><button class="faq-q" onclick="toggleFaq(this)" aria-expanded="false">Quelles garanties sont requises ?<span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-a" role="region">Pour les crédits inférieurs à <strong>300 000 FCFA</strong> : scoring terrain simplifié, pas de garantie immobilière requise. Pour les montants supérieurs : avaliseur ou caution solidaire.</div></div>
          <div class="faq-item"><button class="faq-q" onclick="toggleFaq(this)" aria-expanded="false">Qu'est-ce que le CGI DJANGUI+ ?<span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-a" role="region"><strong>CGI DJANGUI+</strong> est la formalisation numérique de la tontine traditionnelle (Djangui). Votre groupe de <strong>5 à 50 personnes</strong> gère ses cotisations automatiquement via Mobile Money, avec traçabilité complète, contrat formel et protection juridique OHADA.</div></div>
          <div class="faq-item"><button class="faq-q" onclick="toggleFaq(this)" aria-expanded="false">Puis-je rembourser en avance ?<span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-a" role="region">Oui. CGI applique un taux dégressif : les intérêts diminuent chaque mois à mesure que vous remboursez le capital. Le remboursement anticipé est possible <strong>sans pénalité</strong>.</div></div>
        </section>

        <section id="faq-fr-epargne" aria-labelledby="faq-fr-epargne-title">
          <h2 class="faq-cat-title" id="faq-fr-epargne-title">Épargne</h2>
          <div class="faq-item"><button class="faq-q" onclick="toggleFaq(this)" aria-expanded="false">Quel taux d'intérêt sur l'épargne bloquée ?<span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-a" role="region"><strong>CGI BUILD</strong> offre jusqu'à <strong>8 %/an</strong> - l'un des taux les plus élevés du marché local. Le taux est garanti à la signature du contrat d'épargne et ne peut pas être révisé à la baisse pendant la durée convenue.</div></div>
          <div class="faq-item"><button class="faq-q" onclick="toggleFaq(this)" aria-expanded="false">Mon argent est-il en sécurité ?<span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-a" role="region">Oui. En tant qu'établissement en cours d'agrément COBAC, CGI respecte des <strong>ratios prudentiels stricts</strong> (solvabilité, liquidité, transformation) imposés par la réglementation CEMAC. Votre épargne est protégée conformément aux normes COBAC.</div></div>
        </section>

        <section id="faq-fr-digital" aria-labelledby="faq-fr-digital-title">
          <h2 class="faq-cat-title" id="faq-fr-digital-title">Mobile Money &amp; Digital</h2>
          <div class="faq-item"><button class="faq-q" onclick="toggleFaq(this)" aria-expanded="false">CGI est-elle vraiment digitale ?<span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-a" role="region">Oui. CGI intègre nativement <strong>MTN Mobile Money</strong> et <strong>Orange Money</strong> pour les décaissements, remboursements et collectes. Objectif : <strong>80 % des opérations sans déplacement</strong>. Application mobile dédiée prévue pour 2027.</div></div>
          <div class="faq-item"><button class="faq-q" onclick="toggleFaq(this)" aria-expanded="false">Puis-je utiliser CGI sans smartphone ?<span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-a" role="region">Absolument. CGI fonctionne avec tout téléphone mobile compatible MTN MoMo ou Orange Money, même sans smartphone, via USSD. Notre agence physique est ouverte <strong>Lun–Ven 7h30–16h30 et Sam 8h–13h</strong>.</div></div>
        </section>

        <section id="faq-fr-formation" aria-labelledby="faq-fr-form-title">
          <h2 class="faq-cat-title" id="faq-fr-form-title">Formation &amp; Accompagnement</h2>
          <div class="faq-item"><button class="faq-q" onclick="toggleFaq(this)" aria-expanded="false">CGI propose-t-elle des formations ?<span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-a" role="region"><p>Oui - c'est l'un de nos avantages compétitifs majeurs. Chaque membre bénéficie :</p><ul class="faq-ul"><li>Session d'orientation de 30 min à l'adhésion</li><li>Formations mensuelles gratuites en gestion et éducation financière</li><li>Appel mensuel de suivi personnalisé</li></ul><p class="faq-note">Emprunteurs ≥ 500 000 FCFA : coaching individuel inclus.</p></div></div>
          <div class="faq-item"><button class="faq-q" onclick="toggleFaq(this)" aria-expanded="false">Comment contacter CGI ?<span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-a" role="region"><ul class="faq-contact-list"><li><a href="tel:+237693539586">+237 693 53 95 86</a></li><li><a href="mailto:wh@cgi-mfi.com">wh@cgi-mfi.com</a></li><li>Yaoundé, Marché Mokolo</li><li>Bafoussam, Tamdja - face PMUC</li><li>WhatsApp Business disponible</li><li>Lun–Ven : 7h30–16h30 &nbsp;·&nbsp; Sam : 8h–13h</li></ul></div></div>
        </section>

        <div class="faq-contact-cta" aria-label="Besoin d'aide supplémentaire">
          <div class="faq-contact-cta-text">
            <h3>Vous n'avez pas trouvé votre réponse ?</h3>
            <p>Notre équipe répond dans les 24h ouvrables - par téléphone, email ou WhatsApp.</p>
          </div>
          <div class="faq-contact-cta-actions">
            <a href="tel:+237693539586" class="faq-contact-btn faq-contact-btn-primary">Appeler CGI</a>
            <a href="{{ path('home') }}#join" class="faq-contact-btn faq-contact-btn-outline">Devenir Membre</a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/faq.js') }}" defer></script>
{% endblock %}
