{% extends 'base.html.twig' %}

{% block title %}Page introuvable (404) | CGI MFI{% endblock %}
{% block meta_description %}La page que vous recherchez est introuvable. Retournez à l'accueil CGI MFI — Microfinance inclusive à Yaoundé, Cameroun.{% endblock %}
{% block canonical %}https://www.cgi-mfi.com/{% endblock %}

{% block stylesheets %}
<style>
  .error-page { min-height: 72vh; display: flex; align-items: center; background: var(--surface-1, #f8f8f8); }
  .error-inner { max-width: 680px; margin: 0 auto; padding: 80px 24px; text-align: center; }
  .error-code { font-size: clamp(96px, 18vw, 160px); font-weight: 900; line-height: 1; color: var(--gold, #c8a84b); letter-spacing: -4px; margin-bottom: 0; }
  .error-title { font-size: clamp(22px, 4vw, 32px); font-weight: 700; color: var(--text-primary, #1a1a2e); margin: 8px 0 16px; }
  .error-desc { font-size: 16px; color: var(--text-secondary, #555); line-height: 1.7; margin-bottom: 40px; }
  .error-links { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin-bottom: 48px; }
  .error-sep { width: 48px; height: 3px; background: var(--gold, #c8a84b); margin: 0 auto 32px; border-radius: 2px; }
  .error-suggestions { background: #fff; border-radius: 12px; padding: 28px; box-shadow: 0 2px 16px rgba(0,0,0,.06); text-align: left; }
  .error-suggestions h3 { font-size: 14px; text-transform: uppercase; letter-spacing: .8px; color: var(--text-secondary, #888); margin-bottom: 16px; }
  .error-sugg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
  .error-sugg-link { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: var(--surface-1, #f8f8f8); border-radius: 8px; font-size: 14px; font-weight: 500; color: var(--text-primary, #1a1a2e); text-decoration: none; transition: background .2s, color .2s; }
  .error-sugg-link:hover { background: var(--gold, #c8a84b); color: #1a1a2e; }
  .error-sugg-link svg { flex-shrink: 0; opacity: .6; }
</style>
{% endblock %}

{% block body %}
<main class="error-page" role="main" aria-labelledby="error-heading">
  <div class="error-inner">
    <div class="error-code" aria-hidden="true">404</div>
    <div class="error-sep"></div>
    <h1 class="error-title" id="error-heading">Page introuvable</h1>
    <p class="error-desc">
      Cette page n'existe pas ou a été déplacée.<br>
      Revenez à l'accueil pour accéder à nos services de microfinance.
    </p>

    <div class="error-links">
      <a href="{{ path('home') }}" class="btn btn-primary">← Retour à l'accueil</a>
      <a href="{{ path('home') }}#join" class="btn btn-outline">Rejoindre CGI</a>
    </div>

    <div class="error-suggestions">
      <h3>Pages principales</h3>
      <div class="error-sugg-grid">
        <a href="{{ path('home') }}#products" class="error-sugg-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
          Nos Produits
        </a>
        <a href="{{ path('simulateur_credit') }}" class="error-sugg-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="8" x2="16" y1="10" y2="10"/><line x1="8" x2="12" y1="14" y2="14"/></svg>
          Simulateur
        </a>
        <a href="{{ path('faq') }}" class="error-sugg-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
          FAQ
        </a>
        <a href="{{ path('agenda') }}" class="error-sugg-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          Agenda
        </a>
        <a href="{{ path('cgi_foundation') }}" class="error-sugg-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
          CGI Foundation
        </a>
        <a href="{{ path('home') }}#join" class="error-sugg-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
          Adhésion
        </a>
      </div>
    </div>
  </div>
</main>
{% endblock %}
