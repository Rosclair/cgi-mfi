<!-- FLOATING CTA -->
<div class="floating-cta">
  <a href="{{ path('home') }}#join" class="float-btn">Devenir Membre CGI</a>
</div>

<!-- SEARCH OVERLAY -->
<div class="search-overlay" id="searchOverlay" role="search" aria-label="Recherche CGI">
  <div class="search-box">
    <div class="search-input-wrap">
      <span class="search-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </span>
      <input type="search" id="searchInput" placeholder="Rechercher dans CGI…"
             oninput="updateSearch(this.value)" aria-label="Terme de recherche">
      <button class="search-close" onclick="closeSearch()" aria-label="Fermer la recherche">✕</button>
    </div>
    <div id="searchSuggs" class="search-suggs" role="listbox" aria-label="Suggestions"></div>
  </div>
</div>

<!-- MODAL SUCCÈS -->
<div class="modal-overlay" id="successModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal-box">
    <button class="modal-close-btn" onclick="document.getElementById('successModal').classList.remove('open')" aria-label="Fermer">✕</button>
    <div class="success-icon success-icon--ok" aria-hidden="true">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
    </div>
    <h3 id="modalTitle">Merci pour votre intérêt !</h3>
    <p id="modalMsg">Notre équipe vous contactera dans les 24 heures ouvrables.</p>
    <button class="btn btn-primary btn-full"
            onclick="document.getElementById('successModal').classList.remove('open')">Fermer</button>
  </div>
</div>

{% if app.flashes('success') is not empty %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var msg = {{ app.flashes('success')|first|json_encode|raw }};
    document.getElementById('modalMsg').textContent = msg;
    document.getElementById('successModal').classList.add('open');
  });
</script>
{% endif %}
{% if app.flashes('error') is not empty %}
<div id="flashError" style="position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#c0392b;color:#fff;padding:14px 24px;border-radius:8px;font-size:14px;z-index:9999;box-shadow:0 4px 16px rgba(0,0,0,.2);" role="alert">
  {{ app.flashes('error')|first }}
  <button onclick="this.parentElement.remove()" style="background:none;border:none;color:#fff;margin-left:16px;cursor:pointer;font-size:16px;" aria-label="Fermer">✕</button>
</div>
{% endif %}

{% block extra_modals %}{% endblock %}

<!-- Scripts -->
<script src="{{ asset('js/global.js') }}" defer></script>
{% block javascripts %}{% endblock %}

</body>
</html>
